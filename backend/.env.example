# Copy this file to backend/.env and fill it in. backend/.env is git-ignored: never commit it.
# Real environment variables override anything in this file.

# --- Supabase database --------------------------------------------------------
# Supabase dashboard -> Connect -> "Session pooler". It works on IPv4 networks
# (the "Direct connection" host is IPv6-only on the free plan).
#
# Supabase shows:  postgresql://postgres.abcdefghijkl:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Becomes:
DB_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require&tcpKeepAlive=true&connectTimeout=10&socketTimeout=20
DB_USERNAME=postgres.abcdefghijkl
DB_PASSWORD=your-database-password

# socketTimeout makes a dropped connection fail in 20 s instead of hanging forever.
# If you ever use the "Transaction pooler" (port 6543) instead, add &prepareThreshold=0 to DB_URL.

# Supabase plans cap connections; 5 is plenty for this app.
DB_POOL_SIZE=5

# --- Auth ---------------------------------------------------------------------
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
